# Copy this file to .env and fill in values locally.
# .env is gitignored. Leave the values here blank.

EXAMPLE_API_KEY=

# Send to my phone (harness/phone_push.py -> harness/notify.py). Dry run unless TM_SEND_LIVE=1 AND NTFY_TOPIC are set.
# ntfy topics are readable by anyone who knows the name: use a long random one, set it only in your local .env.
# The judging demo sidebar still defaults a topic when this file is blank.
SEND_BACKEND=
NTFY_TOPIC=

# Primary: private chat bot (free). Make a bot with @BotFather, paste its token here, send /start to it from
# your phone, then run: .venv/bin/python -m harness.phone_push --telegram-setup --write
TM_PHONE_BACKEND=
TELEGRAM_BOT_TOKEN=
TM_TELEGRAM_CHAT_ID=
# Arming (TM_SEND_LIVE=1) is read from the process env only, never from this file.
