# Copy this file to .env and fill in values locally.
# .env is gitignored. Leave the values here blank.

EXAMPLE_API_KEY=

# Send to my phone (harness/phone_push.py -> harness/notify.py). Dry run unless TM_SEND_LIVE=1 AND NTFY_TOPIC are set.
# ntfy topics are readable by anyone who knows the name: use a long random one, set it only in your local .env.
SEND_BACKEND=
NTFY_TOPIC=
